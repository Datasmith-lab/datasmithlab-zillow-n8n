    {
      "id": "b9cee195-210d-4f25-b03e-dd63bd133672",
      "name": "Validate configuration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const c=$input.first().json,a=c.actorInput;\nif(!c.spreadsheetId||c.spreadsheetId.startsWith('REPLACE_'))throw new Error('Set spreadsheetId.');\nif(!Array.isArray(a.locations)||a.locations.length!==1||!/^\\d{5}$/.test(a.locations[0])||a.startUrls?.length||a.searchUrls?.length||a.onlyNewOrChanged!==false||a.marketSummary!==false||a.mode!=='forSale'||!Number.isInteger(a.maxItems)||a.maxItems<1||a.maxItems>100)throw new Error('Use one ZIP, forSale, tracking/summary off and maxItems 1 to 100.');\nif(!Number.isFinite(c.maxTotalChargeUsd)||c.maxTotalChargeUsd<=0||c.maxTotalChargeUsd>1)throw new Error('Set run charge cap above zero and no more than $1.');return [{json:c}];"
      }
