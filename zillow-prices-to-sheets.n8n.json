    {
      "id": "26faeb3d-b762-424d-9f4a-1744355d8e50",
      "name": "Prepare delivery",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const c=$('Configuration').first().json,a=c.actorInput,run=$('Check run status').first().json;\nconst health=$('Get HEALTH').first().json,searches=$('Get SEARCHES').first().json.body,listings=$input.first().json.body;\nif(!Array.isArray(listings)||!Array.isArray(searches)||searches.length!==1||searches[0].search!==a.locations[0]||searches[0].status!=='ok'||health.listings!==listings.length||health.marketSummaryRows!==0||health.removedRows!==0||health.chargeLimitReached||health.skippedUnreadable>0||!Array.isArray(health.searchesFailed)||health.searchesFailed.length||listings.length>a.maxItems||run.stats?.restartCount>0)throw new Error('Unreliable or failed search; inspect HEALTH/SEARCHES before writing.');\nconst stable={};for(const k of Object.keys(a).sort())if(!['maxItems','onlyNewOrChanged','marketSummary'].includes(k))stable[k]=Array.isArray(a[k])?[...a[k]].sort():a[k];const scope=JSON.stringify(stable);\nconst all=$('Read saved listings').all().map(i=>i.json).filter(r=>r.key),keys=new Set();for(const r of all){if(keys.has(r.key))throw new Error('Duplicate saved key; fix Listings before retrying.');keys.add(r.key);}\nconst old=new Map(all.filter(r=>r.scope===scope).map(r=>[r.key,r])),rows=new Map(old),seen=new Set(),now=new Date().toISOString(),drops=[],increases=[],newIds=[];\nconst number=v=>v!==null&&v!==undefined&&v!==''&&Number.isFinite(Number(v))&&Number(v)>0?Number(v):null;\nfor(const item of listings){\n if(item.recordType!=='listing'||!/^zillow:[^|]+$/.test(item.id||'')||!/^https:\\/\\//.test(item.url||'')||item.mode!==a.mode||item.zipcode!==a.locations[0]||seen.has(item.id))throw new Error('Invalid listing fields, scope mismatch or duplicate source ID.');seen.add(item.id);\n const key=scope+'|'+item.id,previous=old.get(key),before=number(previous?.price),price=number(item.price);let changeType=previous?'UNCHANGED':'BASELINE',delta='',pct='',changedAt=previous?.priceChangedAt||'';\n if(previous&&price!==null&&before!==null&&price!==before){delta=price-before;pct=Math.round(delta/before*10000)/100;changeType=delta<0?'PRICE_DROP':'PRICE_INCREASE';changedAt=now;(delta<0?drops:increases).push(item.id);}\n if(!previous)newIds.push(item.id);\n rows.set(key,{key,scope,listingId:item.id,address:String(item.address??''),zipcode:String(item.zipcode??''),price:price??before??'',previousPrice:previous?(delta!==''?before:previous.previousPrice||''):'',priceChange:delta!==''?delta:(previous?.priceChange??''),priceChangePct:pct!==''?pct:(previous?.priceChangePct??''),changeType:delta!==''?changeType:(previous?.changeType||changeType),sourcePriceChange:item.zillowPriceChange??'',url:item.url,firstSeenAt:previous?.firstSeenAt||now,lastSeenAt:now,priceChangedAt:changedAt,runId:run.id,sourceStatus:price===null?'observed-price-missing':String(item.status??'')});\n}\nreturn [{json:{rows:[...rows.values()],runId:run.id,observedRows:listings.length,newIds,priceDrops:drops,priceIncreases:increases,coverage:listings.length>=a.maxItems?'at-row-limit':'below-row-limit-not-proof-of-completeness'}}];"
      }
    },
