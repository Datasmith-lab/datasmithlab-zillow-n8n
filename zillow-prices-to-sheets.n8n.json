        "jsCode": "return [{json:{spreadsheetId:'REPLACE_WITH_SPREADSHEET_ID',maxTotalChargeUsd:0.10,actorInput:{locations:['78701'],mode:'forSale',maxItems:20,onlyNewOrChanged:false,marketSummary:false,splitByZip:true}}}];"
